FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/services/constellation
WORKDIR /app

COPY services/constellation/requirements.txt /tmp/requirements-constellation.txt
RUN pip install --no-cache-dir -r /tmp/requirements-constellation.txt

COPY services/constellation/constellation /app/services/constellation/constellation
COPY packages/lifecycle/prompt.md /app/packages/lifecycle/prompt.md

EXPOSE 8787
CMD ["python", "-m", "constellation.backend"]
